# WS-C REQ-C-6 — re-apply the tenant isolation rules after Docker starts.
# Docker recreates its iptables chains on daemon start; without this unit the
# DOCKER-USER rules from firewall.sh would be lost on every daemon restart or
# host reboot (AC-C-4). Installed by bootstrap.sh to
# /etc/systemd/system/idbots-firewall.service.
[Unit]
Description=IDBots tenant network isolation rules (DOCKER-USER)
After=docker.service network-online.target
Requires=docker.service
# Docker may rewrite chains slightly after it reports active; the small delay
# keeps the rules last-write-wins without racing the daemon.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# Dual-stack hosts (staging + production tenant networks on one Docker daemon)
# list parallel subnet/CP entries — see firewall.sh header. Values with spaces
# must be quoted. Single-stack hosts need nothing (defaults apply).
#Environment="IDBOTS_TENANT_SUBNET=172.30.0.0/16 172.31.0.0/16"
#Environment="IDBOTS_CP_IP=172.30.0.2 172.31.0.2"
ExecStartPre=/bin/sleep 3
ExecStart=/opt/idbots/firewall.sh

[Install]
WantedBy=multi-user.target
