# WS-C REQ-C-10 — control-plane environment, one line per WS-B variable.
# Copy to /etc/idbots/cp.env, then: chown root:root /etc/idbots/cp.env && chmod 0600 /etc/idbots/cp.env
# NEVER commit the filled file. Placeholders below are NOT working values.
# See docs/cloud-mobile/20-ws-b-control-plane.md "Configuration".

# --- public origin ----------------------------------------------------------
# https://app.{APP_DOMAIN} on production, https://staging.{APP_DOMAIN} on staging.
CP_PUBLIC_ORIGIN=https://app.example.com

CP_LISTEN=0.0.0.0:8080
CP_METRICS_LISTEN=0.0.0.0:9100

# SQLite file on the persistent cp-data volume.
CP_DB_PATH=/var/lib/idbots-cp/cp.sqlite

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts tenant gateway secrets at rest. Offline copy lives with the owner.
CP_MASTER_KEY=REPLACE_ME_base64_32_bytes

# Docker Engine API through the socket proxy (compose service name).
CP_DOCKER_URL=http://docker-socket-proxy:2375

# Default tenant image for new tenants ({version}-{commit7}, built by CI).
CP_TENANT_IMAGE=registry.cn-hongkong.aliyuncs.com/idbots/tenant:0.0.0-0000000

# Tenant docker network (compose project "idbots" + network "tenants").
CP_TENANT_NETWORK=idbots_tenants

# C1 resources.
CP_TENANT_MEMORY_MB=2304
CP_TENANT_CPUS=2

# Extra env passed to every tenant as IDBOTS_METASO_API_BASE.
# Production: https://www.metaso.network/assist-open-api ; staging: WS-D staging base.
CP_TENANT_ENV_IDBOTS_METASO_API_BASE=https://www.metaso.network/assist-open-api

# --- SMS --------------------------------------------------------------------
# aliyun = real Alibaba Cloud SMS; fake = fixed code 246810 for CP_FAKE_SMS_NUMBERS.
# CP_SMS_MODE=fake refuses to start when CP_PUBLIC_ORIGIN is the production origin.
CP_SMS_MODE=aliyun

# Time-boxed invite-test escape hatch: "true" lets CP_SMS_MODE=fake run on ANY
# origin (deployer knowingly uses fixed-code test SMS; the origin is never
# spoofed). Remove when AliyunSmsProvider ships. Default (unset) = guard on.
CP_SMS_FAKE_ORIGIN_EXPLICIT=

# RAM user with AliyunDysmsFullAccess-equivalent send-only policy. NOT root.
CP_SMS_ACCESS_KEY_ID=REPLACE_ME_ram_sms_access_key_id
CP_SMS_ACCESS_KEY_SECRET=REPLACE_ME_ram_sms_access_key_secret
CP_SMS_SIGN_NAME=REPLACE_ME_approved_signature
CP_SMS_TEMPLATE_LOGIN=REPLACE_ME_template_code_login
CP_SMS_TEMPLATE_REVERIFY=REPLACE_ME_template_code_reverify

# Staging only: comma-separated E.164 test numbers that accept code 246810.
CP_FAKE_SMS_NUMBERS=

# --- alerts -----------------------------------------------------------------
# Feishu or DingTalk robot webhook for provisioning and upgrade failures.
CP_ALERT_WEBHOOK=REPLACE_ME_feishu_or_dingtalk_webhook_url
