# WS-C REQ-C-10 — control-plane environment, one line per WS-B variable.
# Copy to /etc/idbots/cp.env, then: chown root:root /etc/idbots/cp.env && chmod 0600 /etc/idbots/cp.env
# NEVER commit the filled file. Placeholders below are NOT working values.
# See docs/cloud-mobile/20-ws-b-control-plane.md "Configuration".

# --- public origin ----------------------------------------------------------
# https://app.{APP_DOMAIN} on production, https://staging.{APP_DOMAIN} on staging.
CP_PUBLIC_ORIGIN=https://app.example.com

CP_LISTEN=0.0.0.0:8080
CP_METRICS_LISTEN=0.0.0.0:9100

# Environment and capacity accounting. Defaults: production/58, staging/27.
CP_ENVIRONMENT=production
# CP_HOST_ID=h_replace_with_stable_host_id
CP_HOST_CAPACITY=58

# Optional remote host-agent listener. When enabled, all three TLS files are
# required and client certificates are mandatory. Expose this port only on the
# VPC interface, never on the public Internet.
# CP_AGENT_LISTEN=172.31.0.2:9101
# CP_AGENT_TLS_CERT_FILE=/etc/idbots/agent-tls/server.crt
# CP_AGENT_TLS_KEY_FILE=/etc/idbots/agent-tls/server.key
# CP_AGENT_TLS_CA_FILE=/etc/idbots/agent-tls/ca.crt

# Optional PostgreSQL rollout queue. Unset keeps the existing SQLite queue.
# Enable only with compose.operations-db.yml or an approved managed PostgreSQL.
# CP_ROLLOUT_DATABASE_URL=postgresql://idbots:URL_ENCODED_PASSWORD@operations-db:5432/idbots_operations

# SQLite file for users/login/tenant metadata on the persistent cp-data volume.
CP_DB_PATH=/var/lib/idbots-cp/cp.sqlite

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts tenant gateway secrets at rest. Offline copy lives with the owner.
CP_MASTER_KEY=REPLACE_ME_base64_32_bytes

# Docker Engine API through the socket proxy (compose service name).
CP_DOCKER_URL=http://docker-socket-proxy:2375

# Default tenant image for new tenants ({version}-{commit7}, built by CI).
CP_TENANT_IMAGE=registry.cn-hongkong.aliyuncs.com/idbots/tenant:0.0.0-0000000

# Tenant docker network (compose project "idbots" + network "tenants").
CP_TENANT_NETWORK=idbots_tenants

# C1 resources.
CP_TENANT_MEMORY_MB=2304
CP_TENANT_CPUS=2

# Extra env passed to every tenant as IDBOTS_METASO_API_BASE.
# Production: https://www.metaso.network/assist-open-api ; staging: WS-D staging base.
CP_TENANT_ENV_IDBOTS_METASO_API_BASE=https://www.metaso.network/assist-open-api

# Credit pull (plan B): where a tenant asks for its pending ledger grants and
# reports the application result. Use the control plane's address on the
# tenants network (compose pins it: 172.30.0.2 in this file, 172.31.0.2 in the
# production deployment) so the tenant gateway secret never crosses the public
# edge. Unset = the tenant disables the pull loop and logs which vars are
# missing; grants then stay pending instead of silently disappearing.
CP_TENANT_ENV_IDBOTS_CONTROL_PLANE_URL=http://172.30.0.2:8080

# --- mobile system notifications ---------------------------------------------
# Disabled does not claim delivery. fake is restricted to localhost/staging tests.
CP_PUSH_PROVIDER=disabled
# For CP_PUSH_PROVIDER=fcm, inject the complete service-account JSON through the
# deployment secret mechanism; never write it into this example or an image.
# CP_FCM_SERVICE_ACCOUNT_JSON=

# --- SMS --------------------------------------------------------------------
# aliyun = real Alibaba Cloud SMS; fake = fixed code 246810 for CP_FAKE_SMS_NUMBERS.
# CP_SMS_MODE=fake refuses to start when CP_PUBLIC_ORIGIN is the production origin.
CP_SMS_MODE=aliyun

# Time-boxed invite-test escape hatch: "true" lets CP_SMS_MODE=fake run on ANY
# origin (deployer knowingly uses fixed-code test SMS; the origin is never
# spoofed). Remove when AliyunSmsProvider ships. Default (unset) = guard on.
CP_SMS_FAKE_ORIGIN_EXPLICIT=

# RAM user with AliyunDysmsFullAccess-equivalent send-only policy. NOT root.
CP_SMS_ACCESS_KEY_ID=REPLACE_ME_ram_sms_access_key_id
CP_SMS_ACCESS_KEY_SECRET=REPLACE_ME_ram_sms_access_key_secret
CP_SMS_SIGN_NAME=REPLACE_ME_approved_signature
CP_SMS_TEMPLATE_LOGIN=REPLACE_ME_template_code_login
CP_SMS_TEMPLATE_REVERIFY=REPLACE_ME_template_code_reverify

# Staging only: comma-separated E.164 test numbers that accept code 246810.
CP_FAKE_SMS_NUMBERS=

# --- invite service (ABS WS-D) ----------------------------------------------
# Base URL of assist-base-service and shared partner Bearer token (`me.invite_partner_token`).
# When set, new sign-ups precheck invite codes & daily capacity before SMS send,
# consume invite seats via ABS, grant the configured ME trial on first tenant boot,
# and hibernate unsubscribed tenants > CP_INVITE_HIBERNATE_AFTER_DAYS past trial expiry.
CP_INVITE_SERVICE_URL=https://www.metaso.network/assist-open-api
CP_INVITE_API_TOKEN=REPLACE_ME_invite_partner_bearer_token
CP_INVITE_HIBERNATE_AFTER_DAYS=7

# --- alerts -----------------------------------------------------------------
# Feishu or DingTalk robot webhook for provisioning and upgrade failures.
CP_ALERT_WEBHOOK=REPLACE_ME_feishu_or_dingtalk_webhook_url
