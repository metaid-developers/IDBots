# Host agent environment. Store the completed file as /etc/idbots/agent.env mode 0600.
# The agent connects OUTBOUND to the control plane; no Docker API port is exposed.
AGENT_URL=wss://control-plane.internal.example:9101/internal/v1/host-agent
AGENT_HOST_ID=h_replace_with_stable_host_id
AGENT_TOKEN=REPLACE_ME_one_time_agent_token
AGENT_DOCKER_URL=http+unix:///var/run/docker.sock

# Client certificate and CA for mandatory mutual TLS. These files are mounted
# read-only from /etc/idbots/agent-tls; never commit their contents.
AGENT_TLS_CERT_FILE=/etc/idbots/agent-tls/client.crt
AGENT_TLS_KEY_FILE=/etc/idbots/agent-tls/client.key
AGENT_TLS_CA_FILE=/etc/idbots/agent-tls/ca.crt
