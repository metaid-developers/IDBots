# WS-C REQ-C-5 — edge TLS termination for {APP_HOST}.
# APP_HOST is injected from /etc/idbots/deploy.env (app.{APP_DOMAIN} on
# production, staging.{APP_DOMAIN} on staging). Automatic HTTPS: Caddy obtains
# and renews certificates itself (ACME) and redirects HTTP to HTTPS by
# default. Reference configuration frozen in 30-ws-c-infra-ops.md REQ-C-5.

{$APP_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 26MB
	}
	# Legal pages (terms/privacy/custody/support, legacy /disclosure alias)
	# are plain static HTML kept out of the replaceable PWA bundles; sources
	# live in deploy/legal/ and deploy to /srv/idbots-legal on the host.
	# Filename mapping mirrors the deployed host Caddyfile (2026-11-21).
	handle /terms {
		root * /srv/idbots-legal
		rewrite * /terms.html
		file_server
	}
	handle /privacy {
		root * /srv/idbots-legal
		rewrite * /privacy.html
		file_server
	}
	handle /custody {
		root * /srv/idbots-legal
		rewrite * /custody.html
		file_server
	}
	handle /support {
		root * /srv/idbots-legal
		rewrite * /support.html
		file_server
	}
	handle /disclosure {
		root * /srv/idbots-legal
		rewrite * /custody.html
		file_server
	}
	# Versioned, signed Android packages live outside the replaceable PWA bundles.
	handle /downloads/* {
		root * /srv/mobile-bundles
		file_server
		header Content-Type "application/vnd.android.package-archive"
		header Content-Disposition "attachment"
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Plan B tenant credit routes are server-to-server only and their responses
	# carry single-use upstream redeem codes (a bearer value: first redeemer
	# wins). They are reachable exclusively on the internal tenants network
	# (tenant → http://<cp-ip>:8080), never through the public edge.
	@tenantCredit path /api/v1/tenant/*
	respond @tenantCredit 404
	reverse_proxy control-plane:8080 {
		# WebSocket connections stay open without an idle timeout.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# /files/{token} grants short-lived access; never log the token.
				request>uri regexp ^/files/.* /files/REDACTED
			}
		}
	}
}
