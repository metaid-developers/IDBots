<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/idbots_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/updateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/idbots_text_secondary"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/updateNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fadeScrollbars="true">

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/idbots_text_secondary"
            android:textIsSelectable="false"
            android:textSize="15sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/updateProgressGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/updateProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@color/idbots_accent" />

        <TextView
            android:id="@+id/updateProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFeatureSettings="tnum"
            android:textAlignment="center"
            android:textColor="@color/idbots_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
