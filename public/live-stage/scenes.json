{
  "version": 1,
  "protocol": "idbots.live-stage.v1",
  "note": "Declarative scene surface for the official Live Stage template. Every family carries an explicit scene; the 'fallback' key is available to remixes that want a family to reuse another scene. Motion values are the official presentation defaults for a family entered on its own; the host's terminal helpers carry some fields over from the previous state at runtime.",
  "palette": {
    "colorA": "#FFDC51",
    "colorB": "#FFF3B0",
    "colorC": "#FF9D55",
    "colorD": "#22D3EE",
    "highlightColor": "#FFFFFF",
    "shellInner": "#FFFFFF",
    "shellMid": "#FFF3B0",
    "shellEdge": "#FFDC51",
    "sheenColor": "#F4F7FA",
    "specColor": "#FFFFFF",
    "canvasColor": "#0A1220",
    "glowColor": "#FFDC51"
  },
  "handoff": {
    "treatment": "bounded-arc",
    "settleMs": 2600
  },
  "reducedMotion": {
    "behavior": "static-frame"
  },
  "families": {
    "received": {
      "orb": { "style": 9, "preset": "received" },
      "composition": "presence",
      "topology": { "mode": "presence" },
      "motion": { "durationMs": 720, "easing": "emphasized-decelerate", "energy": 0.35, "density": 0.25 }
    },
    "reasoning": {
      "orb": { "style": 15, "preset": "reasoning" },
