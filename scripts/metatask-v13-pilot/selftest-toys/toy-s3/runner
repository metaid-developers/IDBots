#!/usr/bin/env python3
# Toy S3 matrix runner — selftest fixture ONLY.
# Contract: runner --engine <python|go|ts> --vectors <dir> prints
# `CANONICAL_SHA256 <hex>`. The toy derives the digest from the vector-set
# bytes (identical for every engine), which is exactly what the S3 spec
# script's reproduction leg checks against matrix.md.
import argparse
import hashlib
import json
import os

parser = argparse.ArgumentParser()
parser.add_argument("--engine", required=True)
parser.add_argument("--vectors", required=True)
args = parser.parse_args()

digest_input = []
for name in sorted(os.listdir(args.vectors)):
    if name.endswith(".json"):
        with open(os.path.join(args.vectors, name), "rb") as handle:
            digest_input.append(hashlib.sha256(handle.read()).hexdigest())
print("CANONICAL_SHA256 %s" % hashlib.sha256(json.dumps(digest_input).encode()).hexdigest())
