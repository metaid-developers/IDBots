{
  "appId": "ai.idbots.app",
  "productName": "IDBots",
  "executableName": "IDBots",
  "directories": {
    "output": "release"
  },
  "beforePack": "./scripts/electron-builder-hooks.cjs",
  "afterPack": "./scripts/electron-builder-hooks.cjs",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "sandbox/agent-runner/AGENT_SYSTEM_PROMPT.md",
    "sandbox/agent-runner/Bootstrap.md",
    "sandbox/agent-runner/IDBotsPrimer.md"
  ],
  "extraResources": [
    {
      "from": "SKILLs",
      "to": "SKILLs",
      "filter": [
        "**/*",
        "!**/.env",
        "!**/.env.*",
        "!**/.venv/**",
        "!**/venv/**",
        "!**/.*",
        "!**/.*/**",
        "!**/node_modules/**/*.d.ts",
        "!**/node_modules/**/*.d.mts",
        "!**/node_modules/**/*.d.cts",
        "!**/node_modules/**/*.map",
        "!**/node_modules/**/__tests__/**",
        "!**/node_modules/**/tests/**"
      ]
    },
    {
      "from": "METAAPPs",
      "to": "METAAPPs",
      "filter": [
        "**/*",
        "!**/.*",
        "!**/.*/**"
      ]
    },
    {
      "from": "resources/tray",
      "to": "tray",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "src/main/agentGame/adapterSandboxWorker.cjs",
      "to": "agentGame/adapterSandboxWorker.cjs"
    },
    {
      "from": "dsh-runtime",
      "to": "dsh-runtime",
      "filter": [
        "**/*",
        "!**/.test-sessions/**",
        "!**/.spike-sessions/**",
        "!**/*.log",
        "!**/.DS_Store",
        "!**/node_modules/**/*.d.ts",
        "!**/node_modules/**/*.d.mts",
        "!**/node_modules/**/*.d.cts",
        "!**/node_modules/**/*.map",
        "!**/node_modules/**/__tests__/**",
        "!**/node_modules/**/tests/**"
      ]
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "icon": "build/icons/mac/icon.icns",
    "category": "public.app-category.productivity",
    "notarize": false,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extraResources": [
      {
        "from": "resources/ffmpeg/ffmpeg-darwin-${arch}",
        "to": "ffmpeg/ffmpeg-darwin-${arch}"
      }
    ],
    "extendInfo": {
      "CFBundleIconName": "icon",
      "NSCalendarsUsageDescription": "IDBots 需要访问您的日历来帮助您查看和管理日程安排，例如查找事件、创建会议等。",
      "NSRemindersUsageDescription": "IDBots 需要访问您的提醒事项来帮助您管理待办事项。",
      "NSAppleEventsUsageDescription": "IDBots 需要使用 Apple Events 来控制 Calendar 应用执行自动化操作。",
      "NSLocationWhenInUseUsageDescription": "IDBots 需要访问您的位置，以便您的 Bot 回答基于位置的查询（例如查找附近的服务）。精确定位仅在您同意后使用。"
    }
  },
  "dmg": {
    "sign": false
  },
  "afterSign": "scripts/notarize.js",
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icons/win/icon.ico",
    "sign": "scripts/windows-sign.cjs",
    "extraResources": [
      {
        "from": "resources/mingit",
        "to": "mingit",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/python-win",
        "to": "python-win",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ffmpeg/ffmpeg-win32-x64.exe",
        "to": "ffmpeg/ffmpeg-win32-x64.exe"
      }
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icons/png",
    "category": "Utility"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "scripts/nsis-installer.nsh"
  },
  "electronVersion": "40.2.1",
  "asarUnpack": [
    "node_modules/@img/**",
    "node_modules/sql.js/dist/**"
  ],
  "asar": true
}
